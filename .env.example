# Aishe SaaS (local)
OMB_SAAS=1
OMB_HOST=0.0.0.0
OMB_PORT=8799
OMB_SESSION_SECRET=change-me-to-a-long-random-string

# Platform-hosted models (users never see this key)
OLLAMA_API_KEY=

# Shared cloud computer for SaaS teammates (box.ascii.dev)
BOX_TOKEN=

# Composio project API key (ak_…) — enough to Add/connect plugins via Platform OAuth.
# Prefer pasting in App Settings (saved to ~/.aishe/config.json; hot-reloads).
COMPOSIO_API_KEY=
# Optional Connect consumer key (ck_…) — agent MCP tools via connect.composio.dev
# (dashboard → Install / AI Clients → Your API Key). Not required for Add apps.
# COMPOSIO_KEY=

# Convex cloud DB (SaaS persistence). Desktop mode ignores these.
CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=dev:your-deployment|your-deploy-key
# Optional: also in .env.local for `npx convex` CLI
# CONVEX_DEPLOYMENT=dev:your-deployment
# Shared secret: must match Convex deployment env (npx convex env set OMB_HARNESS_SECRET …)
OMB_HARNESS_SECRET=change-me-to-a-long-random-string

# Public URL of the app (browser origin). Local Vite UI:
# OMB_PUBLIC_URL=http://127.0.0.1:5199
# Production (Render):
# OMB_PUBLIC_URL=https://grokbot-killer.onrender.com
OMB_PUBLIC_URL=http://127.0.0.1:5199

# Google login (Google Cloud Console → APIs & Services → Credentials → OAuth client)
# Authorized redirect URI must be exactly: {OMB_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar — Aishe Plus (N$350 / month). Checkout link is public; webhook secret is not.
# Webhook URL in Polar: {OMB_PUBLIC_URL}/api/billing/polar/webhook
# Checkout Success URL: {OMB_PUBLIC_URL}/billing/success?checkout_id={CHECKOUT_ID}
# Optional Render cron (every 5 min) so routines run while the dyno is asleep:
# POST {OMB_PUBLIC_URL}/api/cron/routines
# Authorization: Bearer $OMB_HARNESS_SECRET
POLAR_CHECKOUT_URL=https://buy.polar.sh/polar_cl_2jpkDME4cRB5agW7DAxlzYIDhJwCEUELCB19n340DAk
POLAR_WEBHOOK_SECRET=
